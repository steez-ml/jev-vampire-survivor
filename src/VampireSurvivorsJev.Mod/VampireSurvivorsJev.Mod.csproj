<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AssemblyName>VampireSurvivorsJev</AssemblyName>
    <RootNamespace>VampireSurvivorsJev</RootNamespace>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\$(Configuration)\</OutputPath>
    <SkipGameCopy>true</SkipGameCopy>

    <GameDir Condition="'$(GameDir)' == '' and '$(VAMPIRE_SURVIVORS_DIR)' != ''">$(VAMPIRE_SURVIVORS_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Vampire Survivors</GameDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <BepInExInteropDir>$(GameDir)\BepInEx\interop</BepInExInteropDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="OverlayBehaviour.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(BepInExCoreDir)\BepInEx.Core.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)\BepInEx.Unity.Common.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExCoreDir)\0Harmony.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\Il2Cppmscorlib.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\UnityEngine.CoreModule.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\PauseSystem.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\PhaserPort.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\Unity.Mathematics.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\Il2CppSystem.Core.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(BepInExInteropDir)\VampireSurvivors.Runtime.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateGameDependencies" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GameDir)')" Text="Vampire Survivors was not found at '$(GameDir)'. Pass -p:GameDir=&quot;...&quot;." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll')" Text="BepInEx/core/BepInEx.Unity.IL2CPP.dll is missing." />
    <Error Condition="!Exists('$(BepInExInteropDir)\VampireSurvivors.Runtime.dll')" Text="BepInEx/interop/VampireSurvivors.Runtime.dll is missing. Launch the empty BepInEx install once so it can generate interop." />
  </Target>

  <Target Name="CopyModToGame" AfterTargets="Build" Condition="'$(SkipGameCopy)' != 'true'">
    <MakeDir Directories="$(GameDir)\BepInEx\plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\BepInEx\plugins" />
    <Message Text="Copied $(TargetFileName) to $(GameDir)\BepInEx\plugins" Importance="high" />
  </Target>

</Project>
