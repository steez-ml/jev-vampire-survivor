{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vampire-survivors-jev:game-state:v4",
  "title": "Vampire Survivors Jev game state v4",
  "description": "Live UDP snapshot. v3 polar occupancy plus additive v4 fields: player progress (level/xp), magnet radius, facing, equipped weapons, Phaser body blocked flags, and a polar wall channel probed from the stage collision tilemaps. Every v4 field is optional so a v3 producer still parses.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "seq",
    "t_ms",
    "source",
    "run",
    "polar",
    "enemies",
    "bosses",
    "chests",
    "counts",
    "perf"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "t_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "string",
      "const": "bepinex"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["running", "paused", "level_up", "survived_seconds"],
      "properties": {
        "running": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "level_up": {
          "type": "boolean"
        },
        "survived_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "hp", "hp_max"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "hp": {
          "type": "number"
        },
        "hp_max": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "radius": {
          "type": "number"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "description": "CharacterController.Level"
        },
        "xp": {
          "type": "number",
          "minimum": 0,
          "description": "CharacterController.Xp (progress inside the current level)"
        },
        "xp_next": {
          "type": "number",
          "minimum": 0,
          "description": "GameManager.LevelUpFactory.XpRequiredToLevelUp; 0 when unknown"
        },
        "magnet": {
          "type": "number",
          "minimum": 0,
          "description": "CharacterController.Magnet.Radius in world units; 0 when unknown"
        },
        "facing_x": {
          "type": "number",
          "description": "-1 faces west, +1 faces east, 0 unknown (CharacterController.LastFacingDirection / IsFlipped)"
        },
        "move_dir": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          },
          "description": "CharacterController.LastMovementDirection"
        },
        "blocked": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": ["up", "down", "left", "right"]
          },
          "description": "Raw Phaser body blocked flags this frame (player.body._blocked). Side naming is Phaser's; the bridge calibrates the Y sense."
        },
        "weapons": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "level"],
            "properties": {
              "type": {
                "type": "string",
                "description": "VampireSurvivors.Data.WeaponType enum name, e.g. WHIP"
              },
              "level": {
                "type": "integer",
                "minimum": 0
              },
              "evo": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        }
      }
    },
    "polar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rings", "sectors", "radii", "enemy", "xp"],
      "properties": {
        "rings": {
          "const": 3
        },
        "sectors": {
          "const": 8
        },
        "radii": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "enemy": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "xp": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "wall": {
          "type": "array",
          "minItems": 24,
          "maxItems": 24,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Fraction of probe points per cell that hit a collision tile (PhaserTilemap.IsTileAtPosition). Absent when the stage has no tileset or the probe is disabled."
        }
      }
    },
    "enemies": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "vx": {
            "type": "number"
          },
          "vy": {
            "type": "number"
          }
        }
      }
    },
    "bosses": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/xy"
      }
    },
    "chests": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/xy"
      }
    },
    "pickups": {
      "type": "array",
      "maxItems": 8,
      "description": "Non-gem floor items (ROAST = chicken, COIN*, VACUUM, ROSARY, ...). Gems stay in polar.xp; chests stay in chests[].",
      "items": {
        "$ref": "#/$defs/typed"
      }
    },
    "destructibles": {
      "type": "array",
      "maxItems": 8,
      "description": "Nearby breakable props (BRAZIER, CANDLE, LAMPOST, ...). Chance of chicken / gold / power-up.",
      "items": {
        "$ref": "#/$defs/typed"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enemies_stage",
        "enemies_published",
        "gems_stage",
        "gems_published",
        "chests_stage",
        "chests_published",
        "bosses_published"
      ],
      "properties": {
        "enemies_stage": {
          "type": "integer",
          "minimum": 0
        },
        "enemies_published": {
          "type": "integer",
          "minimum": 0
        },
        "gems_stage": {
          "type": "integer",
          "minimum": 0
        },
        "gems_published": {
          "type": "integer",
          "minimum": 0
        },
        "chests_stage": {
          "type": "integer",
          "minimum": 0
        },
        "chests_published": {
          "type": "integer",
          "minimum": 0
        },
        "bosses_published": {
          "type": "integer",
          "minimum": 0
        },
        "tilemaps": {
          "type": "integer",
          "minimum": 0,
          "description": "Collision tilemaps probed for polar.wall this snapshot; 0 when the wall channel is not live."
        },
        "pickups_stage": {
          "type": "integer",
          "minimum": 0
        },
        "pickups_published": {
          "type": "integer",
          "minimum": 0
        },
        "destructibles_stage": {
          "type": "integer",
          "minimum": 0
        },
        "destructibles_published": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "perf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_us"],
      "properties": {
        "probe_us": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "xy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "typed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "x", "y"],
      "properties": {
        "type": {
          "type": "string",
          "description": "ItemType or PropType enum name from this install"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
